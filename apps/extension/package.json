{
  "name": "@x-threadpick/extension",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "wxt prepare",
    "dev": "wxt",
    "build": "wxt build -b chrome",
    "build:firefox": "wxt build -b firefox",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@x-threadpick/shared": "workspace:*",
    "dexie": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@wxt-dev/module-react": "^1.2.0",
    "fake-indexeddb": "^6.0.1",
    "jsdom": "^27.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "wxt": "^0.21.0"
  }
}
